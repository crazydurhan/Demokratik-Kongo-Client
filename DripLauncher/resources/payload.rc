#include "resource.h"

// The client core is no longer embedded: the launcher fetches it from the
// update service at inject time (see LISANS_VE_YUKLEME_STANDARTLARI.md).

// Application icon. Deliberately abstract and neutral so it matches the
// "Windows Host Runtime" identity in version.rc -- nothing about the icon
// should read as the game client it actually is.
IDI_APPICON ICON "appicon.ico"
