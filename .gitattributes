# Normalize line endings in the repo; check out native on Windows.
* text=auto

# Explicit text types.
*.c        text
*.cpp      text
*.h        text
*.hpp      text
*.inl      text
*.md       text
*.ps1      text eol=crlf
*.rc       text
*.manifest text
*.props    text eol=crlf
*.vcxproj  text eol=crlf
*.filters  text eol=crlf
*.sln      text eol=crlf
*.yml      text
*.json     text

# Binary — never diff or line-ending-convert.
*.dll  binary
*.exe  binary
*.lib  binary
*.pdb  binary
*.jar  binary
*.png  binary
*.ttf  binary
*.ico  binary

# Vendored third-party code. Excluded from GitHub's language stats and from
# diffs so the reported language breakdown reflects first-party source only.
*/ext/**            linguist-vendored
# Embedded font byte arrays.
include/fonts/**    linguist-vendored
# TweetNaCl (public domain) — Ed25519 verification for licence tokens.
include/licenseShared/tweetnacl.c linguist-vendored
include/licenseShared/tweetnacl.h linguist-vendored
